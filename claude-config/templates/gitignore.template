# .gitignore לתיקיית העבודה. מעתיקים לשורש הריפו בשם .gitignore לפני הקומיט הראשון.
# כל כלל כאן מונע משפחה שלמה של קבצים שלא שייכים לגיט. קל יותר למנוע מאשר לנקות היסטוריה אחר כך.

# --- סודות: לעולם לא לגיט ---
.env
.env.*
*.pem
*.key
**/bots.json
**/mcp.json
**/secrets/
**/*token*.json
**/*credentials*.json

# --- גיבויים וקבצים זמניים ---
**/.backups/
**/tmp/
*.bak
*.old
*.orig
*~

# --- קבצים כבדים: מעל 100MB גיטהאב חוסם, ווידאו גולמי לא צריך היסטוריה ---
*.mov
*.MOV
*.mp4
*.wav
*.zip

# --- מידע אישי ומידע לקוחות שהתחייבתם למחוק ---
# הוסיפו כאן נתיב לכל תיקייה כזו, לפני שהיא נכנסת לקומיט הראשון.

# --- זבל של מערכת ושל כלים ---
.DS_Store
Thumbs.db
desktop.ini
node_modules/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
*.log

# --- מצב מקומי של בוטים וגשרים ---
**/state/
